# snort-local.rules
# Custom Snort 3 detection rules — SME network
# Author: Giselle Koch
# ISO 27001 A.8.16 — Monitoring activities

# ────────────────────────────────────────────
# PORT SCANNING
# ────────────────────────────────────────────

# SYN scan detection (Nmap default)
alert tcp any any -> $HOME_NET any (
    msg:"SCAN Nmap SYN Scan Detected";
    flags:S;
    threshold: type both, track by_src, count 20, seconds 5;
    classtype:network-scan;
    sid:1000001; rev:1;
)

# FIN scan
alert tcp any any -> $HOME_NET any (
    msg:"SCAN TCP FIN Scan";
    flags:F,!APRSUE;
    classtype:network-scan;
    sid:1000002; rev:1;
)

# NULL scan
alert tcp any any -> $HOME_NET any (
    msg:"SCAN TCP NULL Scan";
    flags:0;
    classtype:network-scan;
    sid:1000003; rev:1;
)

# XMAS scan
alert tcp any any -> $HOME_NET any (
    msg:"SCAN TCP XMAS Scan";
    flags:FPU;
    classtype:network-scan;
    sid:1000004; rev:1;
)

# ────────────────────────────────────────────
# SSH BRUTE FORCE
# ────────────────────────────────────────────

alert tcp any any -> $HOME_NET 22 (
    msg:"BRUTE SSH login attempt";
    flow:to_server,established;
    content:"SSH";
    threshold: type both, track by_src, count 5, seconds 60;
    classtype:attempted-admin;
    sid:1000010; rev:1;
)

# ────────────────────────────────────────────
# SQL INJECTION PROBES
# ────────────────────────────────────────────

alert http any any -> $HTTP_SERVERS any (
    msg:"SQLI Union Select Probe";
    http.uri;
    content:"union"; nocase;
    content:"select"; nocase; distance:0;
    classtype:web-application-attack;
    sid:1000020; rev:1;
)

alert http any any -> $HTTP_SERVERS any (
    msg:"SQLI Single Quote Probe";
    http.uri;
    content:"'";
    pcre:"/('\s*(or|and)\s*'?[0-9])/i";
    classtype:web-application-attack;
    sid:1000021; rev:1;
)

# ────────────────────────────────────────────
# REVERSE SHELL INDICATORS
# ────────────────────────────────────────────

alert tcp $HOME_NET any -> any any (
    msg:"BACKDOOR Bash Reverse Shell Outbound";
    flow:established;
    content:"/bin/bash";
    content:"-i";
    classtype:trojan-activity;
    sid:1000030; rev:1;
)

alert tcp $HOME_NET any -> any any (
    msg:"BACKDOOR Python Reverse Shell Outbound";
    flow:established;
    content:"import socket";
    content:"os.dup2";
    classtype:trojan-activity;
    sid:1000031; rev:1;
)

# ────────────────────────────────────────────
# DNS TUNNELLING
# ────────────────────────────────────────────

alert dns any any -> any 53 (
    msg:"DNS Tunnelling — Long Subdomain";
    dns.query;
    pcre:"/[a-zA-Z0-9]{40,}\./";
    classtype:policy-violation;
    sid:1000040; rev:1;
)
